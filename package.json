{
  "name": "konversi-css-scss",
  "version": "1.0.0",
  "description": "Landing page Muhammad Fadhil — konversi CSS ke SCSS",
  "scripts": {
    "sass": "sass --no-source-map scss/style.scss css/style.css",
    "sass:watch": "sass --watch scss/style.scss css/style.css",
    "sass:min": "sass --style=compressed --no-source-map scss/style.scss css/style.min.css"
  },
  "devDependencies": { "sass": "^1.105.0" }
}
